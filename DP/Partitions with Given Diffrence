class Solution {
public:
    int solve(vector<int>& arr, int target, int i, vector<vector<int>>& dp){
       if (i == arr.size()) {
            return target == 0;
        }


        if(dp[i][target] != -1) return dp[i][target];
        int take = 0;
        if(arr[i] <= target){
            take = solve(arr, target - arr[i], i + 1, dp);   
        }
        int nottake = solve(arr, target, i + 1, dp);

        return dp[i][target] = take + nottake;
    }

    int countPartitions(vector<int>& arr, int diff) {
        int n = arr.size();
        int totalsum = 0;
        // s1 - s2 = diff
        // s1 + s2 = total
//         (s1 - s2) + (s1 + s2) = diff + total

//        2*s1 = total + diff
//        s1 = (total + diff) / 2

        for(int x : arr) totalsum += x;

        if((diff + totalsum) % 2 != 0) return 0;
        if(diff > totalsum) return 0;

        int target = (diff + totalsum) / 2;

        vector<vector<int>> dp(n, vector<int>(target + 1, -1));

        return solve(arr, target, 0, dp);
    }
};

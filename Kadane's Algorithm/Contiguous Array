class Solution {
public:
    int findMaxLength(vector<int>& nums) {

        int n = nums.size();

        // 0 -> -1
        // 1 -> +1
        for(int i = 0; i < n; i++){
            if(nums[i] == 0){
                nums[i] = -1;
            }
            else{
                nums[i] = 1;
            }
        }

        unordered_map<int, int> mp;

        // sum 0 array start hone se pehle
        mp[0] = -1;

        int sum = 0;
        int ans = 0;

        for(int i = 0; i < n; i++){

            sum += nums[i];

            if(mp.find(sum) != mp.end()){

                ans = max(ans, i - mp[sum]);

            }
            else{

                // first occurrence store karo
                mp[sum] = i;
            }
        }

        return ans;
    }
};

class Solution {
public:
    int getlen(ListNode* head) {
        int len = 0;
        ListNode* temp = head;
        while (temp != NULL) {
            len++;
            temp = temp->next;
        }
        return len;
    }
    ListNode* rotateRight(ListNode* head, int k) {
        if (head == NULL || head->next == NULL) {
            return head;
        }
        int length = getlen(head);
        k = k % length;
        int nodesfromfront = length - k;
        ListNode* newtailNode = head;
        for (int i = 1; i < nodesfromfront; i++) {
            newtailNode = newtailNode->next;
        }
        // Last node find karo
        ListNode* tail = head;

        while (tail->next != NULL) {
            tail = tail->next;
        }

        // connect circular
        tail->next = head;
        ListNode* newHead = newtailNode->next;

        newtailNode->next = NULL;

        return newHead;
    }
};

class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {
        int n= nums.size();
        int i=0;
        int product = 1;
        int ans = 0;


        if(k <= 1) return 0;


        for(int j=0; j<n; j++){
            product *= nums[j];
            // agar product bda ho gya to left se hum window shrink krenge
            while(product >= k){
                product /= nums[i];
                i++;
            }
            ans += j-i+1;
        }
        return ans;
    }
};

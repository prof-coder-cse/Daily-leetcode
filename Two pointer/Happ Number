class Solution {
public:
    bool isHappy(int n) {
        // ye lopp me fas skta isliye set me rakhenge number agar vo pehle aa chuka hoga to loop me fas gya matlab
        unordered_set<int>st;
        while(n!= 1){
            int sum = 0;
            if(st.count(n)){
                return false;
            }
            st.insert(n);

            while (n > 0) {
            int digit = n % 10;
            sum += digit * digit;
            n = n / 10;
        }
        n= sum;
        }
        return true;
    }
};

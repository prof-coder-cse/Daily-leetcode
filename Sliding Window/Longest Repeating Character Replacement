class Solution {
public:
    int characterReplacement(string s, int k) {

        // Left pointer of sliding window
        int left = 0;

        // Stores length of longest valid substring found so far
        int ans = 0;

        int n = s.size();

        // Frequency array for characters 'A' to 'Z'
        vector<int> freq(26, 0);

        // Frequency of the most common character in current window
        int maxfreq = 0;

        // Expand the window using right pointer
        for(int right = 0; right < n; right++) {

            // Include current character in the window
            freq[s[right] - 'A']++;

            // Update the maximum frequency character in the window
            maxfreq = max(maxfreq, freq[s[right] - 'A']);

            // If characters to replace exceed k,
            // shrink the window from the left
            while((right - left + 1) - maxfreq > k) {

                // Remove left character from the window
                freq[s[left] - 'A']--;

                // Move left pointer forward
                left++;
            }

            // Current window is valid, update answer
            ans = max(ans, right - left + 1);
        }

        return ans;
    }
};

class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int currsum =0 ;
        int n = nums.size();
        int ans = INT_MIN;
        for(int i=0; i<n ; i++){
            currsum += nums[i];
            
            ans = max(ans , currsum);

            if(currsum < 0){
                currsum = 0;
            }
        }
        return ans;
    }
    int smallestSumSubarray(vector<int>& nums) {
      
        int sum = 0;
        int ans = INT_MAX;

        for(int i = 0; i < nums.size(); i++) {
            sum += nums[i];

            ans = min(ans, sum);

            if(sum > 0)
                sum = 0;
        }

        return ans;
        
    }
    int maxAbsoluteSum(vector<int>& nums) {
        int maxi = maxSubArray(nums);
        int mini = smallestSumSubarray(nums);
        return max(maxi, abs(mini));
    }
};

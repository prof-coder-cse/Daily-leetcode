class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int left =0;
        int n = nums.size();
        int zero_flipped = 0;
        int curr_max = 0;
        for(int right =0 ; right<n ; right++){
            if(nums[right] == 0){
                zero_flipped++;
            }
           while(zero_flipped > k){
            if(nums[left] == 0){  // taki hum dubara 0 ko 1 kr ske
                zero_flipped--;
            }
            // agar 0 nhi hai to aage bdate jayenge
            left++;
           }
           curr_max = max(curr_max , right - left +1);
        }
        return curr_max;
    }
};

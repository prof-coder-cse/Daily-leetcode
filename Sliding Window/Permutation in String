class Solution {
public:
    bool checkInclusion(string s1, string s2) {
        int n = s1.size();
        unordered_map<char , int>mp;
        for(int i=0; i<n; i++){
            mp[s1[i]]++;
        }
        unordered_map<char , int>window;
        
        int left = 0;
        for(int right = 0; right < s2.size(); right++){
            window[s2[right]]++;
            
            if(right - left + 1 == n){ // window size equals n matlab s1.size() ke equal
                if(mp == window) return true;

                // shrink window
                window[s2[left]]--;

                if(window[s2[left]] == 0){
                    window.erase(s2[left]);
                }
                left++;
            }
        }
        return false;
    }
};


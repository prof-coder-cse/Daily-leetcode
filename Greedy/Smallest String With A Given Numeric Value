class Solution {
public:
    string getSmallestString(int n, int k) {
        string result(n , 'a');
        // saaare a daalne ke baad k ki value kitni hogi ab k-n
        k = k-n;

        int right = n-1;

        while(k > 0 && right >=0 ){
                int addthisvalue = min(25 , k);
                result[right] = 'a' + addthisvalue;
                k = k-addthisvalue;
                right--;
        }
        return result;
    }
};



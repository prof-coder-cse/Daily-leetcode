class Solution {
public:
    int findPeakElement(vector<int>& nums) {
        int n = nums.size();
        if(n==1) return 0;
        if(nums[0] > nums[1]) return 0;
        if(nums[n-1] > nums[n-2]) return n-1;

        int s=1 , e=n-1;
        while(s<=e){
            int mid = s+ (e-s)/2;
            if(nums[mid]< nums[mid+1]){
                // peak must be on right side
                s= mid+1;
            }
            else if(nums[mid] <nums[mid-1]){
                // peak must be on left side
                e = mid-1;
            }
            else return mid;
        }
        return -1;
    }
};

class Solution {
public:

    bool canallocate(vector<int>& candies, int mid, long long k){
        long long child = 0;

        for(auto pile : candies){
            child += pile / mid;
        }

        return child >= k;
    }
    
    int maximumCandies(vector<int>& candies, long long k) {
        int ans = 0;

        int i = 1;
        int j = *max_element(candies.begin(), candies.end());

        while(i <= j){
            int mid = i + (j - i) / 2;
            
            if(canallocate(candies, mid, k)){
                ans = mid;
                
                // possible hai, aur zyada candies try karo
                i = mid + 1;
            }
            else{
                // possible nahi hai
                j = mid - 1;
            }
        }

        return ans;
    }
};

class Solution {
public:
    int solve(vector<int>& prices , int i , int buy, int k,  vector<vector<vector<int>>>& dp){
    if(i == prices.size()) return 0;
    if(k == 0){
        return 0;
    }
    if (dp[i][buy][k] != -1) {
        return dp[i][buy][k];
    }
    if(buy==1){
        // two options we have either we can buy or we cam skip /ignore
        // buy
        int take = -prices[i] + solve(prices , i+1 , 0, k , dp);
        // ignore
        int skip = solve(prices , i+1 , 1, k, dp);

        return dp[i][buy][k] = max(take, skip);
    }
    else { // buy->0
         // two options we have either we can sell or we cam skip /ignore
         int sell = prices[i] + solve(prices , i+1 ,1 ,k-1 , dp);

         int skip = solve(prices , i+1 , 0, k,  dp);
          return dp[i][buy][k] = max(sell, skip);
    }
}
    int maxProfit(int k, vector<int>& prices) {
         int n = prices.size();
        vector<vector<vector<int>>> dp(n, vector<vector<int>>(2, vector<int>(k+1 , -1)));
        int buy = 1; // allowed to buy
        int ans = solve(prices , 0 , buy,k, dp);
        return ans;
    }
};

class Solution {
public:
    long long solve(vector<int>& prices, int i , int CASE , int k,  vector<vector<vector<long long>>>&dp){
        if(i== prices.size()){
            if(CASE == 0){
                return 0; // all transaction completed no pending
            }
            else{
                // matlab transaction pending thi aur out of bound ho gya
                return INT_MIN;
            }
        }
        if(dp[i][CASE][k] != -1){
            return dp[i][CASE][k];
        }
        long long take =INT_MIN;
        long long dont_take = solve(prices , i+1 , CASE , k, dp);
         if(k>0){
            if(CASE == 1){
                // buy kr chuke ho ab sell karo
                take = prices[i] + solve(prices , i+1 , 0 , k-1, dp);
                // ab iske baad fresh transaction allowed hai and ek transaction kam ho gyi k me se

            }
            else if(CASE== 2){
              // buy krna hai kyuki short sell kar chuka hu
              take = -prices[i] +solve(prices , i+1, 0 , k-1, dp);
              // short sell kiya aur fir ab buy kar liya transaction complete.. ready for fresh transaction
            }
            else{
                // case 0 fresh // ise hum ye to normal buy sell kare ya fir shortsell and buy kare
                take = max(-prices[i]+ solve(prices , i+1 , 1 , k, dp) , prices[i]+solve(prices , i+1 ,2, k, dp));
            }
         }
        dp[i][CASE][k] = max(take, dont_take);

        return dp[i][CASE][k];
    }
    long long maximumProfit(vector<int>& prices, int k) {
        int n = prices.size();
        // starting me 0 bhej rhe matlab fresh transaction
        // case 1 matlab buy kr chuke ho sell krna hai
        // case 2 matlab shortsell kiya hai ab buy kro
        vector<vector<vector<long long>>>dp(n+1 , vector<vector<long long>>(3 , vector<long long>(k+1 , -1)));
        long long ans = solve(prices , 0 , 0 , k, dp);

        return ans;
    }
};

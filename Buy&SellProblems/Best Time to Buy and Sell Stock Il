class Solution {
public:

    // i = current index
    // buy = 1 -> we are allowed to buy
    // buy = 0 -> we already bought, now we can sell

    int solve(int i, int buy, vector<int>& prices,  vector<vector<int>>& dp) {

        // base case
        if(i >= prices.size()) {
            return 0;
        }
        if(dp[i][buy] != -1){
            return dp[i][buy];
        }
        int profit = 0;

        // Buy allowed
        if(buy == 1) {

            // buy stock
            int buyProfit = -prices[i] + solve(i + 1, 0, prices, dp);

            // skip buying
            int skipProfit = solve(i + 1, 1, prices, dp);

            profit = max(buyProfit, skipProfit);
        }

        // Sell allowed
        else {

            // sell stock
            int sellProfit = prices[i] + solve(i + 1, 1, prices, dp);

            // skip selling
            int skipProfit = solve(i + 1, 0, prices, dp);

            profit = max(sellProfit, skipProfit);
        }

        return dp[i][buy] = profit;
    }

    int maxProfit(vector<int>& prices) {
        int n = prices.size();
        vector<vector<int>>dp(n+1 , vector<int>(2 ,-1 ));
        return solve(0, 1, prices, dp);

    }
};

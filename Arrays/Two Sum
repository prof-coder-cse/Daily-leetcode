class Solution {
public:
    // TC - o(n) + O(nlogn)
    // SC - O(1)
    vector<int> twoSum(vector<int>& nums, int target) {
        int n = nums.size();
        sort(nums.begin() , nums.end());
        int left =0 , right = n-1;
        while(left < right){
            if(nums[left] + nums[right] == target){
                return{ left , right};
            }
            else if(nums[left] + nums[right] < target) left++;
            else right--; 
        }
        return{-1 , -1};
    }
};

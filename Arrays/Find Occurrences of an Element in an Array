class Solution {
public:
    vector<int> occurrencesOfElement(vector<int>& nums, vector<int>& queries, int x) {
        int n = nums.size();
        vector<int>occurences;

        for(int i=0; i<n ; i++){
            if(x == nums[i]){
              occurences.push_back(i);
            }
        }
        vector<int>ans;

        for(auto q:queries){
            if(q <= occurences.size()){
                ans.push_back(occurences[q-1]); // 0 based index hai isliye
            }
            else{
                ans.push_back(-1);
            }
        }
        return ans;
    }
};

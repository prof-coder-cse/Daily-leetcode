class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
        int n = matrix.size();
        int m = matrix[0].size();
        int total = n*m;
        int lo = 0;
        int hi = total-1;

        while(lo<=hi){
            int mid = lo + (hi-lo)/2;

            int rowindex = mid/m;  // to map 1d index into 2d matrix row
            int columnindex = mid%m;  // to map 1d index into 2d matrix column
            if(target == matrix[rowindex][columnindex]){
                return true;
            }
            else if(target > matrix[rowindex][columnindex]){
                lo = mid+1;
            } 

            else hi = mid-1;
        }
        return false;
    }
};

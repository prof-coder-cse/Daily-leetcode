class Solution {
public:
   void sortColors(vector<int>& nums) {
     // one pass solution TC- O(n)
     int n = nums.size();
     int i=0; // denotes 0
     int j=0; // denotes 1
     int k = n-1; // denotes 2
     while(j<=k){
        if(nums[j] == 1){
            j++;
        }
        else if(nums[j] == 2){
            // 2 to k ke pass jana chahiye
            swap(nums[j], nums[k]);
            k--;
        }
        else{
            // nums[j] == 1 to i ke pass hona chahiye
            swap(nums[j], nums[i]);
            i++;
            j++;
            // dono aage badenge  kyuke ek sath start hue the starting me
        }
     }
   }
};

          2ND SOLUTION

class Solution {
public:
    // 2 pass solution 
    // Time complexity - O(n)
    
    void sortColors(vector<int>& nums) {
        int n = nums.size();
        int count0 = 0, count1 =0 , count2 =0;
        for(int i=0; i< n ; i++){
            if(nums[i] == 0){
                count0 ++;
            }
            else if(nums[i] == 1) count1++;
            else count2 ++;
        }
        int idx =0;
        for(int i=0 ; i<count0 ; i++){
            nums[idx] = 0;
            idx++;
        }
        for(int i=0; i< count1 ; i++){
            nums[idx] = 1;
            idx++;
        }
        for(int i=0 ; i<count2 ; i++){
            nums[idx] = 2;
            idx++;
        }
    }
};

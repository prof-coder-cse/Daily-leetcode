class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        vector<int>prefixsum(n , 0);
        int count =0;

        prefixsum[0] = nums[0];
        for(int i=1; i<n ; i++){
            prefixsum[i] = prefixsum[i-1] + nums[i];
        }
        unordered_map<int,int>mp;
        for(int j=0; j<n ; j++){
            if(prefixsum[j] == k){
                count++;
            }
            int value = prefixsum[j] - k;
            if(mp.find(value) != mp.end()){
                count += mp[value];
            }
            if(mp.find(prefixsum[j]) == mp.end()){
                mp[prefixsum[j]] = 0;
            }
            mp[prefixsum[j]]++;
        }
        return count;
    }
};

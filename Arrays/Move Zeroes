class Solution {
public:
    void moveZeroes(vector<int>& arr) {
        int n = arr.size();
        vector<int>temp(n);

        int j =0; 
        for(int i=0; i<n ; i++){
            if(arr[i] != 0){
                temp[j++] = arr[i];
            }
        }
        while(j< n){
            temp[j++] = 0;
        }
        for(int i=0; i<n ; i++){
            arr[i] = temp[i];
        }
    }
};

OPTIMAL SOLUTION

class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int j = 0;  // position for next non-zero

        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] != 0) {
                swap(nums[i], nums[j]);
                j++;
            }
        }
    }
};

class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_map<char, int> mp; // stores last seen  index of each char before whilee expanding
        int left = 0;
        int maxLen = 0;
        int n = s.length();

        for (int right = 0; right < n; right++) {
            char ch = s[right];

            // if character already seen and its last index >= left, move left
            if (mp.find(ch) != mp.end() && mp[ch] >= left) {
                left = mp[ch] + 1;
            }

            // update last index of current char
            mp[ch] = right;

            // update max length
            maxLen = max(maxLen, right - left + 1);
        }

        return maxLen;
    }
};

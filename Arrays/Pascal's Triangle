class Solution {
public:
    vector<vector<int>> generate(int numRows) {
        vector<vector<int>>matrix(numRows);
        for(int i=0; i<numRows ; i++){
            matrix[i] = vector<int>(i+1 , 1); // har row me i+1 columns honge 2d matrix me

            for(int j=1; j<i ; j++){
                // first and last column humesha 1 rehte hai isliye include nhi kar rhe
                matrix[i][j] = matrix[i-1][j] + matrix[i-1][j-1];
            }
        }
        return matrix;
    }
};

class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n = nums.size();
        vector<int>subarrmin(n);
        subarrmin[n-1] = nums[n-1];
        for(int i=n-2; i>=0 ; i--){
            subarrmin[i] = min(nums[i] , subarrmin[i+1]);
        }
        int leftmax = nums[0];
        for(int i=0; i<n ; i++){
            leftmax = max(leftmax , nums[i]);
            int diff = leftmax - subarrmin[i];
            if(diff <= k){
                return i;
            }
        }
        return -1;
    }
};

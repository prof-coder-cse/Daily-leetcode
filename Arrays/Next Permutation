class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int n = nums.size();
        int indextobereplaced = -1;
        for(int i=n-1 ; i>0 ; i--){
            if(nums[i] > nums[i-1]){
                indextobereplaced = i-1;
                break;
            }
        }
        if(indextobereplaced != -1){
            int indextobeswapped = indextobereplaced;
        // ab hum next gretaer elemnt dhundhenge
        for(int j=n-1 ; j>=indextobereplaced ; j--){
            if(nums[j] > nums[indextobereplaced]){
                indextobeswapped = j;
                break;
            }
        }
        // ab swap kardo
        swap(nums[indextobereplaced] , nums[indextobeswapped]);

        }
        
        reverse(nums.begin() + indextobereplaced + 1, nums.end()); // swap krne ke baad right ke index ko reverse karenge saare

    }
};

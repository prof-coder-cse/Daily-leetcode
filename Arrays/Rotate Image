class Solution {
public:
    // Time compleity - O(n*2)
    // Space complexity - o(1)
    void rotate(vector<vector<int>>& matrix) {
        int n = matrix.size();

    // Step 1: Transpose
    for(int i = 0; i < n; i++) {
        for(int j = i; j < n; j++) {
            swap(matrix[i][j], matrix[j][i]); // example replace mat[1][2] by mat[2][1]
        }
    }

    // Step 2: Reverse each row
    for(int i = 0; i < n; i++) {
        reverse(matrix[i].begin(), matrix[i].end());  // reverse each row takes n time , so to revrese  rows N*2
    }
    }
};

class Solution {
public:
    string mapWordWeights(vector<string>& words, vector<int>& weights) {
        int n = words.size();
        string result= "";
        for(auto word: words){
             int sum =0;
             for(auto ch:word ){
                 sum += weights[ch - 'a'];
             }

             int takingmoduloofsum = sum % 26;
             result += ('z' - takingmoduloofsum);
        }
        return result;
    }
};

class Solution {
public:
   // Time complexity - O(n)
   // Space complexity - O(1)
    int maxSubArray(vector<int>& nums) {
        int n = nums.size();
        int max_sum = INT_MIN;
       int currsum =0 ;
       for(int i=0; i<n ; i++){
             currsum += nums[i];
             max_sum = max(currsum , max_sum);
             if(currsum < 0){
                currsum = 0;
             }
       }
       return max_sum ;
    }
};

class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        queue<int>positive;
        queue<int>negative;
        vector<int>ans;

        int n = nums.size();
        for(auto x:nums){
            if(x>0){
                positive.push(x);
            }
            else{
                negative.push(x);
            }
        }
        while(!positive.empty() && !negative.empty()){
            ans.push_back(positive.front());
            positive.pop();

            ans.push_back(negative.front());
            negative.pop();
        }
        return ans;
    }
};
